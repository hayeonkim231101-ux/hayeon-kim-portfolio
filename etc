## CLI 진입점 (배치/스케줄러에서 쓸 때용. 쥬피터에서는 실행되지 않습니다) --------------------

def parse_args(argv=None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--ay", type=int, default=None, help="학년도 (기본값: 오늘 기준 자동 계산)")
    parser.add_argument("--from-ymd", type=str, default=None, help="수집 시작일(YYYYMMDD), --ay 대신 직접 지정")
    parser.add_argument("--to-ymd", type=str, default=None, help="수집 종료일(YYYYMMDD), --ay 대신 직접 지정")
    parser.add_argument("--schools-csv", type=str, default=None, help="학교 목록 CSV (ATPT_OFCDC_SC_CODE,SD_SCHUL_CODE,SCHUL_NM). 미지정 시 Snowflake에서 조회")
    parser.add_argument("--limit", type=int, default=None, help="테스트용 처리 학교 수 제한")
    parser.add_argument("--dry-run", action="store_true", help="Snowflake 적재 없이 수집 결과만 CSV로 저장")
    parser.add_argument("--out", type=str, default="dry_run_result.csv", help="--dry-run 시 저장할 CSV 경로")
    parser.add_argument(
        "--api-key",
        type=str,
        default=None,
        help="나이스 Open API 인증키. 환경변수 NEIS_API_KEY보다 우선 적용됩니다.",
    )
    return parser.parse_args(argv)


def main(argv=None) -> int:
    args = parse_args(argv)
    api_key = args.api_key or NEIS_API_KEY or None
    run(
        ay=args.ay,
        from_ymd=args.from_ymd,
        to_ymd=args.to_ymd,
        schools_csv=args.schools_csv,
        limit=args.limit,
        api_key=api_key,
        dry_run=args.dry_run,
        dry_run_out=args.out,
    )
    return 0


if __name__ == "__main__" and not hasattr(sys, "ps1") and "ipykernel" not in sys.modules:
    # 쥬피터/인터랙티브 환경에서는 이 블록을 건너뛰고, 아래 "실행" 셀을 쓰세요.
    try:
        sys.exit(main())
    except Exception:
        log.exception("작업이 실패했습니다.")
        raise



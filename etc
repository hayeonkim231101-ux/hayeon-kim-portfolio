## 자료형 정의 -----------------------------------------------------------------

@dataclass
class School:
    atpt_ofcdc_sc_code: str
    sd_schul_code: str
    schul_nm: str = ""


@dataclass
class FetchStats:
    schools_total: int = 0
    schools_with_data: int = 0
    schools_failed: int = 0
    rows_total: int = 0
    failed_schools: list = field(default_factory=list)


# %%
## 학년도 / 학교 목록 ------------------------------------------------------------

def default_academic_year(today: date | None = None) -> int:
    """NEIS 학년도(AY)는 3월 시작. 1~2월은 전년도 학년도로 간주."""
    today = today or date.today()
    return today.year if today.month >= 3 else today.year - 1


def default_date_range(ay: int) -> tuple[str, str]:
    """학년도 기준 3/1 ~ 익년 2월 말일 (윤년이면 2/29까지 정확히 계산)."""
    end_date = date.fromordinal(date(ay + 1, 3, 1).toordinal() - 1)
    return f"{ay}0301", end_date.strftime("%Y%m%d")


def load_schools_from_csv(path: str) -> list[School]:
    schools: list[School] = []
    with open(path, newline="", encoding="utf-8-sig") as f:
        reader = csv.DictReader(f)
        required_cols = {"ATPT_OFCDC_SC_CODE", "SD_SCHUL_CODE"}
        if not required_cols.issubset(set(reader.fieldnames or [])):
            raise ValueError("학교 CSV에는 ATPT_OFCDC_SC_CODE, SD_SCHUL_CODE 컬럼이 필요합니다.")
        for row in reader:
            office_code = (row.get("ATPT_OFCDC_SC_CODE") or "").strip()
            school_code = (row.get("SD_SCHUL_CODE") or "").strip()
            if office_code and school_code:
                schools.append(
                    School(
                        atpt_ofcdc_sc_code=office_code,
                        sd_schul_code=school_code,
                        schul_nm=(row.get("SCHUL_NM") or "").strip(),
                    )
                )
    return schools


def load_schools_from_neis(session: requests.Session, api_key: str | None) -> list[School]:
    """NEIS schoolInfo API에서 전국 학교 목록(ATPT_OFCDC_SC_CODE/SD_SCHUL_CODE)을 가져옵니다.

    주의: Snowflake의 TOK.TOK.SE_SCHOOL_INFO_BASE(학교알리미 데이터)는 코드 체계가
    달라(SCHOOL_INFO_CODE가 NEIS SD_SCHUL_CODE와 다름) 여기서 쓸 수 없습니다.
    """
    schools: list[School] = []
    p_index = 1
    while True:
        params = {"Type": "json", "pIndex": p_index, "pSize": PAGE_SIZE}
        if api_key:
            params["KEY"] = api_key

        payload = _request_with_retry(session, params, base_url=NEIS_SCHOOL_INFO_URL)
        if payload is None:
            raise RuntimeError("NEIS schoolInfo API 호출 실패")

        result_code = _extract_result_code(payload, node_key="schoolInfo")
        if result_code == "INFO-200":
            break
        if result_code and result_code != "INFO-000":
            message = _extract_result_message(payload, node_key="schoolInfo")
            raise RuntimeError(f"NEIS schoolInfo API 오류 [{result_code}] {message}")

        info_node = payload.get("schoolInfo")
        page_rows = []
        if isinstance(info_node, list) and len(info_node) > 1:
            page_rows = info_node[1].get("row", []) or []

        for row in page_rows:
            office_code = (row.get("ATPT_OFCDC_SC_CODE") or "").strip()
            school_code = (row.get("SD_SCHUL_CODE") or "").strip()
            # 개교 전 학교("가칭" 등)는 SD_SCHUL_CODE가 공백으로 내려오므로 제외합니다.
            if office_code and school_code:
                schools.append(
                    School(
                        atpt_ofcdc_sc_code=office_code,
                        sd_schul_code=school_code,
                        schul_nm=(row.get("SCHUL_NM") or "").strip(),
                    )
                )

        if len(page_rows) < PAGE_SIZE:
            break
        p_index += 1

    return schools


# %%
## NEIS API 호출 ----------------------------------------------------------------

def fetch_school_schedule(
    session: requests.Session,
    school: School,
    from_ymd: str,
    to_ymd: str,
    api_key: str | None,
) -> list[dict]:
    """한 학교의 학사일정을 전체 페이지 수집."""
    rows: list[dict] = []
    p_index = 1
    while True:
        params = {
            "Type": "json",
            "pIndex": p_index,
            "pSize": PAGE_SIZE,
            "ATPT_OFCDC_SC_CODE": school.atpt_ofcdc_sc_code,
            "SD_SCHUL_CODE": school.sd_schul_code,
            "AA_FROM_YMD": from_ymd,
            "AA_TO_YMD": to_ymd,
        }
        if api_key:
            params["KEY"] = api_key

        payload = _request_with_retry(session, params)
        if payload is None:
            raise RuntimeError(f"NEIS API 호출 실패: {school.atpt_ofcdc_sc_code}/{school.sd_schul_code}")

        result_code = _extract_result_code(payload)
        if result_code == "INFO-200":
            break  # 해당 학교/기간 데이터 없음
        if result_code and result_code != "INFO-000":
            message = _extract_result_message(payload)
            raise RuntimeError(f"NEIS API 오류 [{result_code}] {message}")

        schedule_node = payload.get("SchoolSchedule")
        page_rows = []
        if isinstance(schedule_node, list) and len(schedule_node) > 1:
            page_rows = schedule_node[1].get("row", []) or []
        rows.extend(page_rows)

        if len(page_rows) < PAGE_SIZE:
            break
        p_index += 1

    return rows


def _request_with_retry(session: requests.Session, params: dict, base_url: str = NEIS_BASE_URL) -> dict | None:
    for attempt in range(1, MAX_RETRY + 1):
        try:
            resp = session.get(base_url, params=params, timeout=15)
            resp.raise_for_status()
            time.sleep(REQUEST_SLEEP_SEC)
            return resp.json()
        except (requests.RequestException, ValueError) as exc:
            log.warning("NEIS 호출 재시도 %s/%s: %s", attempt, MAX_RETRY, exc)
            time.sleep(1.0 * attempt)
    return None


def _extract_result_code(payload: dict, node_key: str = "SchoolSchedule") -> str | None:
    for key in (node_key, "RESULT"):
        node = payload.get(key)
        if isinstance(node, dict) and "CODE" in node:
            return node["CODE"]
        if isinstance(node, list):
            head = node[0].get("head") if node and isinstance(node[0], dict) else None
            if head:
                for item in head:
                    if "RESULT" in item:
                        return item["RESULT"]["CODE"]
    return None


def _extract_result_message(payload: dict, node_key: str = "SchoolSchedule") -> str:
    for key in (node_key, "RESULT"):
        node = payload.get(key)
        if isinstance(node, dict) and "MESSAGE" in node:
            return node["MESSAGE"]
        if isinstance(node, list):
            head = node[0].get("head") if node and isinstance(node[0], dict) else None
            if head:
                for item in head:
                    if "RESULT" in item:
                        return item["RESULT"]["MESSAGE"]
    return "unknown error"


def normalize_row(raw: dict) -> dict:
    """NEIS 응답 1건을 테이블 컬럼 스키마에 맞춰 정규화."""
    return {field_name: raw.get(field_name) for field_name in SCHEDULE_FIELDS}


def collect_all(
    schools: Iterable[School],
    from_ymd: str,
    to_ymd: str,
    api_key: str | None,
) -> tuple[list[dict], FetchStats]:
    stats = FetchStats()
    all_rows: list[dict] = []

    with requests.Session() as session:
        for school in schools:
            stats.schools_total += 1
            try:
                raw_rows = fetch_school_schedule(session, school, from_ymd, to_ymd, api_key)
            except RuntimeError as exc:
                stats.schools_failed += 1
                stats.failed_schools.append((school.sd_schul_code, str(exc)))
                log.error("수집 실패 - %s(%s): %s", school.schul_nm, school.sd_schul_code, exc)
                continue

            if raw_rows:
                stats.schools_with_data += 1
                stats.rows_total += len(raw_rows)
                all_rows.extend(normalize_row(r) for r in raw_rows)

            if stats.schools_total % 100 == 0:
                log.info(
                    "진행 %d개교 처리 (누적 %d건, 실패 %d건)",
                    stats.schools_total,
                    stats.rows_total,
                    stats.schools_failed,
                )

    return all_rows, stats


# %%
## Snowflake 연결 / 적재 ----------------------------------------------------------

def _load_private_key_bytes(key_path: str, passphrase: str | None) -> bytes:
    from cryptography.hazmat.backends import default_backend
    from cryptography.hazmat.primitives import serialization

    with open(key_path, "rb") as f:
        p_key = serialization.load_pem_private_key(
            f.read(),
            password=passphrase.encode() if passphrase else None,
            backend=default_backend(),
        )
    return p_key.private_bytes(
        encoding=serialization.Encoding.DER,
        format=serialization.PrivateFormat.PKCS8,
        encryption_algorithm=serialization.NoEncryption(),
    )


def get_snowflake_connection(
    account: str = SNOWFLAKE_ACCOUNT,
    user: str = SNOWFLAKE_USER,
    private_key_path: str = SNOWFLAKE_PRIVATE_KEY_PATH,
    private_key_passphrase: str = SNOWFLAKE_PRIVATE_KEY_PASSPHRASE,
    warehouse: str = SNOWFLAKE_WAREHOUSE,
    role: str = SNOWFLAKE_ROLE,
):
    """사내 표준인 Snowflake 키페어(RSA 개인키) 인증으로 접속합니다."""
    import snowflake.connector

    private_key_der = _load_private_key_bytes(private_key_path, private_key_passphrase or None)

    conn_kwargs = {
        "account": account,
        "user": user,
        "private_key": private_key_der,
        "warehouse": warehouse,
    }
    if role:
        conn_kwargs["role"] = role

    return snowflake.connector.connect(**conn_kwargs)


def load_to_snowflake(conn, rows: list[dict], coll_ymd: str) -> None:
    import pandas as pd
    from snowflake.connector.pandas_tools import write_pandas

    if not rows:
        log.warning("적재할 행이 없어 Snowflake 적재를 건너뜁니다.")
        return

    df = pd.DataFrame(rows, columns=SCHEDULE_FIELDS)

    # 1) MT_SCHOOL_SCHEDULE : 전체 재적재 (최신 스냅샷)
    mt_db, mt_schema, mt_name = MT_TABLE.split(".")
    with conn.cursor() as cur:
        # write_pandas가 임시 스테이지를 만들 때 세션에 현재 DB/스키마가 필요합니다.
        cur.execute(f"USE DATABASE {mt_db}")
        cur.execute(f"USE SCHEMA {mt_schema}")
        cur.execute(f"TRUNCATE TABLE {MT_TABLE}")
    success, _, nrows, _ = write_pandas(
        conn, df, table_name=mt_name, database=mt_db, schema=mt_schema, quote_identifiers=False
    )
    if not success or nrows != len(df):
        raise RuntimeError(f"MT 적재 결과 확인 실패: success={success}, nrows={nrows}, expected={len(df)}")
    log.info("MT_SCHOOL_SCHEDULE 적재 완료: %d행", nrows)

    # 2) SE_SCHOOL_SCHEDULE : 이력 누적 (같은 COLL_YMD 재실행 시 중복 방지 위해 선삭제 후 적재)
    df_se = df.copy()
    df_se.insert(0, "COLL_YMD", coll_ymd)
    se_db, se_schema, se_name = SE_TABLE.split(".")
    with conn.cursor() as cur:
        cur.execute(f"USE DATABASE {se_db}")
        cur.execute(f"USE SCHEMA {se_schema}")
        cur.execute(f"DELETE FROM {SE_TABLE} WHERE COLL_YMD = %s", (coll_ymd,))
    success, _, nrows, _ = write_pandas(
        conn, df_se, table_name=se_name, database=se_db, schema=se_schema, quote_identifiers=False
    )
    if not success or nrows != len(df_se):
        raise RuntimeError(f"SE 적재 결과 확인 실패: success={success}, nrows={nrows}, expected={len(df_se)}")
    log.info("SE_SCHOOL_SCHEDULE 적재 완료: %d행 (COLL_YMD=%s)", nrows, coll_ymd)


def write_csv_preview(rows: list[dict], path: str) -> None:
    if not rows:
        log.warning("미리보기로 저장할 행이 없습니다.")
        return
    with open(path, "w", newline="", encoding="utf-8-sig") as f:
        writer = csv.DictWriter(f, fieldnames=SCHEDULE_FIELDS)
        writer.writeheader()
        writer.writerows(rows)
    log.info("드라이런 결과 저장: %s (%d행)", path, len(rows))


# %%
## 한 번에 실행하는 함수 (쥬피터/CLI 공통) -------------------------------------------

def run(
    ay: int | None = None,
    from_ymd: str | None = None,
    to_ymd: str | None = None,
    schools_csv: str | None = None,
    limit: int | None = None,
    api_key: str | None = None,
    dry_run: bool = False,
    dry_run_out: str = "dry_run_result.csv",
) -> FetchStats:
    """NEIS 학사일정을 수집해서 Snowflake에 적재(또는 드라이런)합니다."""
    if bool(from_ymd) != bool(to_ymd):
        raise ValueError("from_ymd와 to_ymd는 함께 지정해야 합니다.")
    if not from_ymd:
        ay = ay or default_academic_year()
        from_ymd, to_ymd = default_date_range(ay)

    log.info("수집 기간: %s ~ %s", from_ymd, to_ymd)

    if not api_key:
        log.warning("인증키가 설정되지 않았습니다. 인증키 없이 호출하면 호출 한도가 낮을 수 있습니다.")

    conn = None
    try:
        if schools_csv:
            schools = load_schools_from_csv(schools_csv)
        else:
            with requests.Session() as school_info_session:
                schools = load_schools_from_neis(school_info_session, api_key)

        if limit:
            schools = schools[:limit]

        if not schools:
            raise RuntimeError("수집 대상 학교가 0개입니다. 학교 목록을 확인하세요.")

        log.info("대상 학교 수: %d", len(schools))

        rows, stats = collect_all(schools, from_ymd, to_ymd, api_key)

        log.info(
            "수집 완료 - 전체 %d개교 / 데이터 존재 %d개교 / 실패 %d개교 / 총 %d행",
            stats.schools_total,
            stats.schools_with_data,
            stats.schools_failed,
            stats.rows_total,
        )
        if stats.failed_schools:
            for code, err in stats.failed_schools[:20]:
                log.error("  실패 학교코드 %s: %s", code, err)

        if dry_run:
            write_csv_preview(rows, dry_run_out)
            return stats

        if not rows:
            raise RuntimeError("수집 결과가 0건입니다. 기존 MT/SE 테이블 보호를 위해 적재를 중단합니다.")

        if conn is None:
            conn = get_snowflake_connection()
        coll_ymd = date.today().strftime("%Y%m%d")
        load_to_snowflake(conn, rows, coll_ymd)
        return stats
    finally:
        if conn is not None:
            conn.close()


